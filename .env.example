# Copy to .env.local. Matches docker-compose.yml.
DATABASE_URL=postgres://meridian:meridian@localhost:5433/meridian

# HR Assistant chatbot LLM — any OpenAI-compatible /chat/completions endpoint.
# Default: Ollama from docker-compose.yml (free, runs locally, data stays on this machine).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=
# Free cloud alternatives (sign up for a key; employee data is sent to that provider):
#   Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-8b-instant
#   Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=<any model ending in :free>
# Set LLM_DISABLED=true to use only the rule-based answers.
