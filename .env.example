# Copy to .env.local for local dev. Matches docker-compose.yml.
# On Vercel, set the same names in Project Settings → Environment Variables
# (see README "Deploying to Vercel"); .env.local is never uploaded.
DATABASE_URL=postgres://meridian:meridian@localhost:5433/meridian
# Vercel: a hosted Postgres URL instead, e.g. Neon / Supabase:
#   DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
# (Vercel's Neon integration injects POSTGRES_URL, which also works.)

# HR Assistant chatbot LLM — any OpenAI-compatible /chat/completions endpoint.
# Default: Ollama from docker-compose.yml (free, runs locally, data stays on this machine).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=
# Free cloud alternatives (sign up for a key; employee data is sent to that provider):
#   Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-8b-instant
#   Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=<any model ending in :free>
# Set LLM_DISABLED=true to use only the rule-based answers.
# On Vercel there is no Ollama: set the three LLM_* vars to a cloud API, or leave
# LLM_BASE_URL unset and the chatbot uses rule-based answers only.

# "Reset demo data" button on the login page. Off in production unless true.
ALLOW_DEMO_RESET=false

# Access code asked for after the splash screen, before the login page.
# Put the real code only in .env.local / your hosting provider's env settings — never commit it.
# Leave empty and nobody can get past the access page.
ACCESS_CODE=
